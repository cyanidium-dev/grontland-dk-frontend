# Sanity (fill in once the CMS project exists)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01

# Quote form → Telegram Bot API (server-only; used by POST /api/quote).
# Optional at build/runtime: if unset, pages still load; submit returns 503
# and the form shows phone/email fallback copy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
